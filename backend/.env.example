# Copy to .env and adjust for local development. No secrets committed.
# Default PostgreSQL port is 5432. If your local PostgreSQL listens on a
# custom port (e.g. 5434), reflect it in DATABASE_URL below.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/assets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=assets
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
DATASET_PATH=./data
# Local-only AI by default. Optional Ollama (never auto-pulls models):
# AI_PROVIDER=local
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=
# Embedding provider: auto (default) | local | deterministic.
# auto: local 512-d CLIP model when already present, else hash fallback.
# local: local model or a clear error. Never downloads anything.
# EMBEDDING_PROVIDER=auto
# Local CLIP model name (default clip-ViT-B-32) and optional explicit
# local weight file (offline only, never downloaded by the app):
# LOCAL_EMBEDDING_MODEL=clip-ViT-B-32
# LOCAL_EMBEDDING_MODEL_PATH=
# Test database URL used by the backend pytest suite:
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/assets_test
